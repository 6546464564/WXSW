<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loadFailedPlaceholder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="48dp"
    android:paddingBottom="32dp"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bs_load_failed"
        android:textColor="@color/wanxiang_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnRetryLoad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bs_action_pill"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:text="@string/bs_retry"
        android:textColor="@color/wanxiang_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
