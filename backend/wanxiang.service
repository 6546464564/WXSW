# 万象书屋后端 systemd 单元
# 安装步骤:
#   sudo cp wanxiang.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now wanxiang

[Unit]
Description=Wanxiang Bookstore Backend
After=network.target

[Service]
Type=simple
User=wanxiang
WorkingDirectory=/opt/wanxiang
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=SECURE_COOKIE=1
# 生产环境必须设置 DEVICE_TOKEN_SECRET (未设置将拒绝启动)
# 首次启动用此密码初始化管理员; 之后改了就忽略, 可以删.
# 请通过 systemctl edit wanxiang 注入真实密码, 勿在仓库中写死.
# Environment=ADMIN_INITIAL_PASSWORD=<随机强密码>
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
